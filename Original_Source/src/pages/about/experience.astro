---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
---

<Layout
    title="Experience — Athrva Pawar"
    description="Athrva Pawar's internship experience and technical learning."
>
    <Navbar />

    <main class="experience-page">

        <!-- HERO -->
        <section class="experience-hero">
            <div class="section-label">// EXPERIENCE</div>

            <h1>
                Learning by<br />
                <span>working with systems.</span>
            </h1>

            <p class="intro">
                My first professional experience gave me the opportunity to
                work with observability, logging, networking, containers,
                and automation tools in a practical environment.
            </p>
        </section>


        <!-- EXPERIENCE -->
        <section class="experience-section">

            <div class="section-heading">
                <span class="section-label">// INTERNSHIP</span>
                <h2>CallHealth</h2>
            </div>

            <div class="experience-header">
                <div>
                    <h3>Intern</h3>
                    <p>
                        A hands-on introduction to monitoring, observability,
                        logging, networking, and infrastructure tooling.
                    </p>
                </div>

                <span class="experience-status">
                    Internship
                </span>
            </div>

        </section>


        <!-- TOOLS -->
        <section class="experience-section">

            <div class="section-heading">
                <span class="section-label">// TOOLS & TECHNOLOGIES</span>
                <h2>What I worked with.</h2>
            </div>

            <div class="tool-groups">

                <div class="tool-group">
                    <span class="tool-number">01</span>

                    <div>
                        <h3>Observability</h3>
                        <p>
                            Grafana, Prometheus, and the ELK stack.
                        </p>
                    </div>
                </div>


                <div class="tool-group">
                    <span class="tool-number">02</span>

                    <div>
                        <h3>Logging & Collection</h3>
                        <p>
                            Filebeat, Windows Exporter, and working with
                            logs as they are captured and processed.
                        </p>
                    </div>
                </div>


                <div class="tool-group">
                    <span class="tool-number">03</span>

                    <div>
                        <h3>Containers & Infrastructure</h3>
                        <p>
                            Docker and the surrounding tooling used to
                            run and connect different components.
                        </p>
                    </div>
                </div>


                <div class="tool-group">
                    <span class="tool-number">04</span>

                    <div>
                        <h3>Networking</h3>
                        <p>
                            Zeek and Wireshark for exploring network
                            traffic and understanding what is happening
                            across a system.
                        </p>
                    </div>
                </div>


                <div class="tool-group">
                    <span class="tool-number">05</span>

                    <div>
                        <h3>Automation</h3>
                        <p>
                            n8n for experimenting with workflow
                            automation and connecting different tools.
                        </p>
                    </div>
                </div>

            </div>

        </section>


        <!-- LEARNING -->
        <section class="experience-section learning-section">

            <div class="section-heading">
                <span class="section-label">// WHAT I LEARNED</span>
                <h2>It was a lot more than tools.</h2>
            </div>

            <div class="learning-grid">

                <div class="learning-card">
                    <span class="learning-number">01</span>
                    <h3>Logs are data.</h3>
                    <p>
                        I learned how logs are generated, collected,
                        transported, and eventually made useful for
                        understanding what is happening inside a system.
                    </p>
                </div>


                <div class="learning-card">
                    <span class="learning-number">02</span>
                    <h3>Systems are connected.</h3>
                    <p>
                        Monitoring a system isn't just about one tool.
                        Different components have to work together to
                        provide a useful picture of what is happening.
                    </p>
                </div>


                <div class="learning-card">
                    <span class="learning-number">03</span>
                    <h3>Setup teaches you things.</h3>
                    <p>
                        Configuring unfamiliar tools, troubleshooting
                        problems, and figuring out why something isn't
                        working taught me as much as the tools themselves.
                    </p>
                </div>

            </div>

        </section>


        <!-- CLOSING -->
        <section class="experience-closing">
            <div class="section-label">// LOOKING BACK</div>

            <h2>
                A lot of new tools.<br />
                <span>One big learning experience.</span>
            </h2>

            <p>
                This internship was my first real exposure to the kind of
                systems that are easy to overlook when you're only writing
                application code. It gave me a much better appreciation for
                how software, infrastructure, networks, and data come
                together.
            </p>
        </section>

    </main>
</Layout>


<style>
    .experience-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 100px 32px 120px;
    }

    .section-label {
        color: var(--color-portfolio-accent);
        font-family: monospace;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.08em;
    }

    .experience-hero {
        max-width: 900px;
        padding: 50px 0 110px;
    }

    .experience-hero h1 {
        margin: 24px 0 30px;
        font-size: clamp(3.5rem, 8vw, 6.5rem);
        line-height: 0.98;
        letter-spacing: -0.055em;
        color: var(--color-portfolio-text);
    }

    .experience-hero h1 span {
        color: var(--color-portfolio-accent);
    }

    .intro {
        max-width: 760px;
        font-size: 1.35rem;
        line-height: 1.7;
        color: var(--color-portfolio-muted);
    }

    .experience-section {
        padding: 90px 0;
        border-top: 1px solid var(--color-portfolio-border);
    }

    .section-heading {
        margin-bottom: 55px;
    }

    .section-heading h2 {
        margin: 12px 0 0;
        font-size: clamp(2rem, 4vw, 3.2rem);
        letter-spacing: -0.04em;
        color: var(--color-portfolio-text);
    }

    .experience-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 40px;
        padding: 32px;
        border: 1px solid var(--color-portfolio-border);
        border-radius: 14px;
        background: var(--color-portfolio-card-bg);
    }

    .experience-header h3 {
        margin: 0 0 12px;
        font-size: 1.8rem;
        color: var(--color-portfolio-text);
    }

    .experience-header p {
        max-width: 650px;
        margin: 0;
        line-height: 1.7;
        color: var(--color-portfolio-muted);
    }

    .experience-status {
        flex-shrink: 0;
        padding: 7px 12px;
        border: 1px solid var(--color-portfolio-border);
        border-radius: 999px;
        color: var(--color-portfolio-muted);
        font-family: monospace;
        font-size: 0.75rem;
    }

    .tool-groups {
        display: flex;
        flex-direction: column;
    }

    .tool-group {
        display: grid;
        grid-template-columns: 70px 1fr;
        gap: 30px;
        padding: 28px 4px;
        border-bottom: 1px solid var(--color-portfolio-border);
    }

    .tool-group:first-child {
        border-top: 1px solid var(--color-portfolio-border);
    }

    .tool-number {
        color: var(--color-portfolio-accent);
        font-family: monospace;
        font-size: 0.8rem;
    }

    .tool-group h3 {
        margin: 0 0 8px;
        font-size: 1.3rem;
        color: var(--color-portfolio-text);
    }

    .tool-group p {
        margin: 0;
        color: var(--color-portfolio-muted);
        line-height: 1.6;
    }

    .learning-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }

    .learning-card {
        padding: 30px;
        border: 1px solid var(--color-portfolio-border);
        border-radius: 14px;
        background: var(--color-portfolio-card-bg);
    }

    .learning-number {
        color: var(--color-portfolio-accent);
        font-family: monospace;
        font-size: 0.8rem;
    }

    .learning-card h3 {
        margin: 22px 0 14px;
        font-size: 1.35rem;
        color: var(--color-portfolio-text);
    }

    .learning-card p {
        margin: 0;
        line-height: 1.7;
        color: var(--color-portfolio-muted);
    }

    .experience-closing {
        padding: 110px 0 40px;
    }

    .experience-closing h2 {
        margin: 20px 0 30px;
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        line-height: 1.05;
        letter-spacing: -0.045em;
        color: var(--color-portfolio-text);
    }

    .experience-closing h2 span {
        color: var(--color-portfolio-accent);
    }

    .experience-closing p {
        max-width: 720px;
        margin: 0;
        font-size: 1.1rem;
        line-height: 1.8;
        color: var(--color-portfolio-muted);
    }

    @media (max-width: 800px) {

        .experience-page {
            padding: 60px 22px 80px;
        }

        .experience-hero {
            padding: 30px 0 80px;
        }

        .experience-section {
            padding: 65px 0;
        }

        .experience-header {
            flex-direction: column;
            gap: 24px;
        }

        .tool-group {
            grid-template-columns: 45px 1fr;
            gap: 15px;
        }

        .learning-grid {
            grid-template-columns: 1fr;
        }

        .experience-closing {
            padding-top: 75px;
        }
    }
</style>