---
import KnightViewer from './KnightViewer.astro';
---

<section id="about" class="relative overflow-hidden border-b border-[var(--color-portfolio-border)]">
  <!-- Subtle background grid -->
  <div class="hero-grid pointer-events-none absolute inset-0"></div>

  <!-- Decorative ambient glow -->
  <div class="hero-glow pointer-events-none absolute"></div>

  <div class="relative mx-auto max-w-5xl px-6 py-20 md:py-28 lg:py-32">
    <div class="grid items-center gap-14 lg:grid-cols-[1fr_0.95fr] lg:gap-20">
      <!-- ================================================= -->
      <!-- LEFT: INTRODUCTION -->
      <!-- ================================================= -->

      <div class="hero-copy">
        <!-- Tiny technical label -->
        <div class="mb-7 flex items-center gap-3">
          <span class="font-mono text-xs tracking-[0.18em] text-blue-600">
            // COMPUTER SCIENCE × CURIOSITY
          </span>

          <span class="h-px w-12 bg-blue-200"></span>
        </div>

        <!-- Main heading -->
        <h1
          class="max-w-3xl text-5xl font-semibold leading-[0.98]
                 tracking-[-0.055em] text-[var(--color-portfolio-text)]
                 sm:text-6xl md:text-7xl xl:text-[5.5rem]"
        >
          I have questions.
          <span class="block text-blue-600"> So I build things. </span>
        </h1>

        <!-- Identity -->
        <p
          class="mt-8 max-w-xl font-mono text-base leading-relaxed
                 text-[var(--color-portfolio-text)]/75 sm:text-lg"
        >
          Computer Science student.
          <br />
          Builder. Experimenter. Professional question-asker.
        </p>

        <!-- Description -->
        <p
          class="mt-6 max-w-xl text-base leading-8 text-[var(--color-portfolio-text)]
                 md:text-lg"
        >
          I build things to understand them — from software and systems to
          whatever interesting corner of computing I happen to fall into next.
        </p>

        <!-- Actions -->
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href="/#projects"
            class="group inline-flex items-center gap-3 rounded-md
                   bg-[var(--color-portfolio-card-bg)] px-5 py-3 font-mono text-xs
                   font-semibold text-white transition-all duration-300
                   hover:-translate-y-0.5 hover:bg-blue-600
                   hover:shadow-lg hover:shadow-blue-600/20"
          >
            Explore Projects

            <span
              class="transition-transform duration-300
                     group-hover:translate-x-1"
            >
              →
            </span>
          </a>

          <a
            href="/about"
            class="inline-flex items-center gap-2 rounded-md
                   border border-[#DCE2EA] bg-[var(--color-portfolio-card-bg)] px-5 py-3
                   font-mono text-xs font-semibold text-[var(--color-portfolio-text)]
                   transition-all duration-300
                   hover:-translate-y-0.5 hover:border-blue-300
                   hover:text-blue-600"
          >
            About Me
          </a>
        </div>

        <!-- Personal motto -->
        <div class="mt-12 max-w-xl border-l-2 border-blue-500 pl-4">
          <p
            class="font-mono text-sm italic leading-relaxed
                   text-[var(--color-portfolio-muted)]"
          >
            “Look underneath the underneath.”
          </p>

          <p
            class="mt-2 font-mono text-[10px] uppercase
                   tracking-[0.16em] text-[var(--color-portfolio-text)]"
          >
            a useful way to approach computers
          </p>
        </div>
      </div>

      <!-- ================================================= -->
      <!-- RIGHT: KNIGHT 3D VIEWER -->
      <!-- ================================================= -->

      <div class="hero-visual mx-auto w-full">
        <!-- Outer vignette frame -->
        <div class="knight-frame">
          <!-- Corner runes (decorative) -->
          <span class="corner corner-tl" aria-hidden="true"></span>
          <span class="corner corner-tr" aria-hidden="true"></span>
          <span class="corner corner-bl" aria-hidden="true"></span>
          <span class="corner corner-br" aria-hidden="true"></span>

          <!-- The 3D viewer -->
          <KnightViewer />

          <!-- Bottom metadata label -->
          <div class="viewer-meta">
            <span class="viewer-meta-dot"></span>
            <span class="viewer-meta-text">knight.glb — interactive</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ================================================= -->
    <!-- BOTTOM SIGNAL -->
    <!-- ================================================= -->

    <div
      class="mt-14 flex flex-col gap-4 border-t border-[var(--color-portfolio-border)]
             pt-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="font-mono text-[10px] tracking-[0.14em] text-[var(--color-portfolio-text)]">
        SOFTWARE / SYSTEMS / EXPERIMENTS
      </p>

      <div class="flex items-center gap-3">
        <span class="h-px w-8 bg-[var(--color-portfolio-card-bg)]"></span>

        <a
          href="/#exploring"
          class="group font-mono text-[10px] tracking-wider
                 text-[var(--color-portfolio-muted)] transition-colors hover:text-blue-600"
        >
          SEE WHAT I'M EXPLORING
          <span
            class="ml-1 transition-transform duration-200
                       group-hover:translate-x-1"
          >
            →
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Background grid (unchanged) ── */
  .hero-grid {
    background-image:
      linear-gradient(rgba(37, 99, 235, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(37, 99, 235, 0.025) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }

  /* ── Ambient glow — warm gold tint for the knight section ── */
  .hero-glow {
    width: 500px;
    height: 500px;
    right: -4%;
    top: 5%;
    border-radius: 50%;
    background: rgba(180, 130, 60, 0.06);
    filter: blur(90px);
  }

  /* ── Entrance animations ── */
  .hero-copy {
    animation: hero-enter 0.8s ease-out both;
  }

  .hero-visual {
    animation: hero-enter 0.9s 0.12s ease-out both;
  }

  @keyframes hero-enter {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0);    }
  }

  /* ── Knight frame ── */
  .knight-frame {
    position: relative;
    width: 100%;
    /* Tall enough to show the full figure on desktop */
    height: clamp(420px, 55vw, 580px);
    border-radius: 0.875rem;
    overflow: hidden;
    /* Thin parchment border */
    border: 1px solid rgba(139, 115, 85, 0.25);
    box-shadow:
      0 0 0 1px rgba(139, 115, 85, 0.08),
      0 24px 60px rgba(0, 0, 0, 0.55),
      inset 0 0 40px rgba(0, 0, 0, 0.4);
    background: #080a0f;
  }

  /* Decorative corner brackets */
  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: rgba(139, 115, 85, 0.45);
    border-style: solid;
    z-index: 10;
    pointer-events: none;
  }
  .corner-tl { top: 10px; left: 10px;  border-width: 1px 0 0 1px; }
  .corner-tr { top: 10px; right: 10px; border-width: 1px 1px 0 0; }
  .corner-bl { bottom: 10px; left: 10px;  border-width: 0 0 1px 1px; }
  .corner-br { bottom: 10px; right: 10px; border-width: 0 1px 1px 0; }

  /* ── Bottom metadata strip ── */
  .viewer-meta {
    position: absolute;
    bottom: 14px;
    right: 18px;
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 10;
    pointer-events: none;
  }

  .viewer-meta-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #8b7355;
    opacity: 0.8;
    animation: pulse-dot 2.4s ease-in-out infinite;
  }

  .viewer-meta-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: rgba(139, 115, 85, 0.6);
    text-transform: uppercase;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 0.4; transform: scale(1);    }
    50%       { opacity: 0.9; transform: scale(1.25); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy,
    .hero-visual { animation: none; }
    .viewer-meta-dot { animation: none; }
  }
</style>
