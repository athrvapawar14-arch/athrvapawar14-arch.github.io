---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
---

<Layout
  title="Achievements — Athrva Pawar"
  description="Athrva Pawar's achievements and accomplishments."
>
  <Navbar />

  <main class="coming-soon-page">
    <div class="section-label">// ACHIEVEMENTS</div>

    <h1>
      Something worth<br />
      <span>adding soon.</span>
    </h1>

    <p>
      I'm still putting together and cataloguing the things
      that belong here. This section will be updated once
      they're properly organised.
    </p>
  </main>
</Layout>

<style>
  .coming-soon-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 160px 32px;
  }

  .section-label {
    color: var(--color-portfolio-accent);
    font-family: monospace;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 24px 0 30px;
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    color: var(--color-portfolio-text);
  }

  h1 span {
    color: var(--color-portfolio-accent);
  }

  p {
    max-width: 650px;
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--color-portfolio-muted);
  }

  @media (max-width: 800px) {
    .coming-soon-page {
      padding: 100px 22px;
    }
  }
</style>