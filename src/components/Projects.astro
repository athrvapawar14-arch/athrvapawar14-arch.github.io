---
const projects = [
  {
    title: "Neural-Network",
    description: "Learning how Neural Networks work and how LLMs work by building them from scratch in Python.",
    tech: ["Python", "Neural Networks", "LLMs"],
    github: "https://github.com/athrvapawar14-arch/Neural-Network",
    demo: "#"
  },
  {
    title: "Shell",
    description: "Learning how Shells work and System Programming by implementing a custom shell in C and C++.",
    tech: ["C", "C++", "System Programming", "Linux"],
    github: "https://github.com/athrvapawar14-arch/Shell",
    demo: "#"
  }
];
---

<section id="projects" class="py-16 border-b border-[#E2E8F0]">
  <div class="space-y-8">
    <!-- Section Header -->
    <div class="space-y-2">
      <h2 class="text-2xl font-bold tracking-tight text-[#1E293B] flex items-center gap-2">
        <span class="font-mono text-sm text-blue-500 font-semibold">//</span> Built Projects
      </h2>
      <p class="text-sm text-[#1E293B]/60 max-w-lg">
        Here's what I've been working on lately.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <article class="group relative flex flex-col justify-between p-6 rounded-lg border border-[#E2E8F0] bg-white transition-all duration-300 hover:-translate-y-1.5 hover:shadow-md hover:border-neutral-300">
          <div class="space-y-4">
            <!-- Title & Arrow -->
            <div class="flex items-start justify-between">
              <h3 class="font-semibold text-base text-[#1E293B] group-hover:text-blue-600 transition-colors duration-200">
                {project.title}
              </h3>
              <span class="text-[#1E293B]/40 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-200">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
            </div>

            <!-- Description -->
            <p class="text-xs md:text-sm text-[#1E293B]/70 leading-relaxed">
              {project.description}
            </p>
          </div>

          <!-- Footer: Tags & Links -->
          <div class="mt-6 space-y-4">
            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5">
              {project.tech.map((tag) => (
                <span class="inline-flex items-center px-2 py-0.5 rounded-sm border border-[#E2E8F0] bg-[#F8F9FA] font-mono text-[9px] md:text-[10px] font-medium text-[#1E293B]/70">
                  {tag}
                </span>
              ))}
            </div>

            <!-- External Actions -->
            <div class="flex items-center gap-4 pt-1 font-mono text-[10px] md:text-xs">
              <a 
                href={project.github} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1 text-[#1E293B]/60 hover:text-[#1E293B] transition-colors"
              >
                <span>Code</span>
                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482C19.138 20.193 22 16.44 22 12.017 22 6.484 17.522 2 12 2z"/>
                </svg>
              </a>
              {project.demo !== "#" && (
                <a 
                  href={project.demo} 
                  class="inline-flex items-center gap-1 text-[#1E293B]/60 hover:text-[#1E293B] transition-colors"
                >
                  <span>Launch</span>
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
