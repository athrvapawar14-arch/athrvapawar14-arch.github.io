---

---

<section id="about" class="relative overflow-hidden border-b border-[var(--color-portfolio-border)]">
  <!-- Subtle background grid -->
  <div class="hero-grid pointer-events-none absolute inset-0"></div>

  <!-- Decorative ambient glow -->
  <div class="hero-glow pointer-events-none absolute"></div>

  <div class="relative mx-auto max-w-5xl px-6 py-20 md:py-28 lg:py-32">
    <div class="grid items-center gap-14 lg:grid-cols-[1fr_0.95fr] lg:gap-20">
      <!-- ================================================= -->
      <!-- LEFT: INTRODUCTION -->
      <!-- ================================================= -->

      <div class="hero-copy">
        <!-- Tiny technical label -->
        <div class="mb-7 flex items-center gap-3">
          <span class="font-mono text-xs tracking-[0.18em] text-blue-600">
            // COMPUTER SCIENCE × CURIOSITY
          </span>

          <span class="h-px w-12 bg-blue-200"></span>
        </div>

        <!-- Main heading -->
        <h1
          class="max-w-3xl text-5xl font-semibold leading-[0.98]
                 tracking-[-0.055em] text-[var(--color-portfolio-text)]
                 sm:text-6xl md:text-7xl xl:text-[5.5rem]"
        >
          I have questions.
          <span class="block text-blue-600"> So I build things. </span>
        </h1>

        <!-- Identity -->
        <p
          class="mt-8 max-w-xl font-mono text-base leading-relaxed
                 text-[var(--color-portfolio-text)]/75 sm:text-lg"
        >
          Computer Science student.
          <br />
          Builder. Experimenter. Professional question-asker.
        </p>

        <!-- Description -->
        <p
          class="mt-6 max-w-xl text-base leading-8 text-[var(--color-portfolio-text)]
                 md:text-lg"
        >
          I build things to understand them — from software and systems to
          whatever interesting corner of computing I happen to fall into next.
        </p>

        <!-- Actions -->
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href="/#projects"
            class="group inline-flex items-center gap-3 rounded-md
                   bg-[var(--color-portfolio-card-bg)] px-5 py-3 font-mono text-xs
                   font-semibold text-white transition-all duration-300
                   hover:-translate-y-0.5 hover:bg-blue-600
                   hover:shadow-lg hover:shadow-blue-600/20"
          >
            Explore Projects

            <span
              class="transition-transform duration-300
                     group-hover:translate-x-1"
            >
              →
            </span>
          </a>

          <a
            href="/about"
            class="inline-flex items-center gap-2 rounded-md
                   border border-[#DCE2EA] bg-[var(--color-portfolio-card-bg)] px-5 py-3
                   font-mono text-xs font-semibold text-[var(--color-portfolio-text)]
                   transition-all duration-300
                   hover:-translate-y-0.5 hover:border-blue-300
                   hover:text-blue-600"
          >
            About Me
          </a>
        </div>

        <!-- Personal motto -->
        <div class="mt-12 max-w-xl border-l-2 border-blue-500 pl-4">
          <p
            class="font-mono text-sm italic leading-relaxed
                   text-[var(--color-portfolio-muted)]"
          >
            “Look underneath the underneath.”
          </p>

          <p
            class="mt-2 font-mono text-[10px] uppercase
                   tracking-[0.16em] text-[var(--color-portfolio-text)]"
          >
            a useful way to approach computers
          </p>
        </div>
      </div>

      <!-- ================================================= -->
      <!-- RIGHT: VISUAL SYSTEM -->
      <!-- ================================================= -->

      <div class="hero-visual mx-auto w-full max-w-md">
        <!-- Decorative orbit -->
        <div class="orbit orbit-one pointer-events-none"></div>
        <div class="orbit orbit-two pointer-events-none"></div>

        <!-- Main artwork -->
        <div
          class="art-frame group relative overflow-hidden rounded-2xl
                 border border-[#DCE2EA] bg-[var(--color-portfolio-card-bg)]
                 shadow-[0_30px_80px_rgba(15,23,42,0.15)]
                 mx-auto w-[92%] md:w-full"
        >
          <img
            src="/images/hero.png"
            alt="Abstract systems and computing artwork featuring an A"
            class="block aspect-[4/3] w-full object-cover
                   transition-transform duration-700
                   group-hover:scale-[1.025]"
          />

          <!-- Dark glass overlay -->
          <div
            class="pointer-events-none absolute inset-0
                   bg-gradient-to-t from-[#08101F]/45
                   via-transparent to-transparent"
          >
          </div>

          <!-- Top-left metadata -->
          <div
            class="absolute left-4 top-4 rounded-md
                   border border-white/10 bg-black/25
                   px-3 py-2 backdrop-blur-md"
          >
            <p class="font-mono text-[9px] tracking-wider text-white/60">
              ATHRVA.SYSTEM
            </p>

            <p class="mt-1 font-mono text-[10px] text-white/90">exploring...</p>
          </div>

          <!-- Bottom-right metadata -->
          <div class="absolute bottom-4 right-4 text-right">
            <p class="font-mono text-[9px] text-white/45">
              build / break / understand
            </p>

            <p class="mt-1 font-mono text-[10px] text-white/75">001 → ∞</p>
          </div>
        </div>

        <!-- Floating diagnostic card -->
        <div
          class="diagnostic-card absolute -bottom-7 -left-5
                 hidden rounded-xl border border-[#DCE2EA]
                 bg-[var(--color-portfolio-card-bg)]/95 p-4 shadow-xl backdrop-blur-md
                 sm:block"
        >
          <div class="flex items-center gap-3">
            <span class="relative flex h-2 w-2">
              <span
                class="absolute inline-flex h-full w-full animate-ping
                       rounded-full bg-blue-400 opacity-50"
              ></span>

              <span
                class="relative inline-flex h-2 w-2 rounded-full
                       bg-blue-600"
              ></span>
            </span>

            <span
              class="font-mono text-[10px] font-semibold
                         tracking-wider text-[var(--color-portfolio-text)]"
            >
              CURRENTLY:
            </span>
          </div>

          <p class="mt-2 font-mono text-xs text-[var(--color-portfolio-muted)]">
            building something interesting
          </p>
        </div>

        <!-- Floating code card -->
        <div
          class="code-card absolute -right-5 -top-6
                 hidden rounded-xl border border-[#DCE2EA]
                 bg-[var(--color-portfolio-card-bg)]/95 p-4 shadow-xl backdrop-blur-md
                 md:block"
        >
          <p class="font-mono text-[9px] text-blue-600">curiosity.log</p>

          <div class="mt-2 space-y-1 font-mono text-[9px] text-[var(--color-portfolio-muted)]">
            <p>&gt; ask_question()</p>
            <p>&gt; build()</p>
            <p>&gt; break()</p>
            <p>&gt; understand()</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ================================================= -->
    <!-- BOTTOM SIGNAL -->
    <!-- ================================================= -->

    <div
      class="mt-14 flex flex-col gap-4 border-t border-[var(--color-portfolio-border)]
             pt-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="font-mono text-[10px] tracking-[0.14em] text-[var(--color-portfolio-text)]">
        SOFTWARE / SYSTEMS / EXPERIMENTS
      </p>

      <div class="flex items-center gap-3">
        <span class="h-px w-8 bg-[var(--color-portfolio-card-bg)]"></span>

        <a
          href="/#exploring"
          class="group font-mono text-[10px] tracking-wider
                 text-[var(--color-portfolio-muted)] transition-colors hover:text-blue-600"
        >
          SEE WHAT I'M EXPLORING
          <span
            class="ml-1 transition-transform duration-200
                       group-hover:translate-x-1"
          >
            →
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    background-image:
      linear-gradient(rgba(37, 99, 235, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(37, 99, 235, 0.035) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }

  .hero-glow {
    width: 420px;
    height: 420px;
    right: 2%;
    top: 10%;
    border-radius: 50%;
    background: rgba(37, 99, 235, 0.055);
    filter: blur(80px);
  }

  .hero-copy {
    animation: hero-enter 0.8s ease-out both;
  }

  .hero-visual {
    animation: hero-enter 0.9s 0.12s ease-out both;
  }

  .art-frame {
    animation: float-art 7s ease-in-out infinite;
  }

  .orbit {
    position: absolute;
    border: 1px dashed rgba(37, 99, 235, 0.22);
    border-radius: 999px;
    pointer-events: none;
  }

  .orbit-one {
    width: 110%;
    height: 72%;
    top: 14%;
    left: -5%;
    transform: rotate(-17deg);
    animation: orbit-one 18s linear infinite;
  }

  .orbit-two {
    width: 82%;
    height: 105%;
    top: -2%;
    left: 9%;
    transform: rotate(28deg);
    animation: orbit-two 22s linear infinite reverse;
  }

  .diagnostic-card {
    animation: float-small 5s ease-in-out infinite;
  }

  .code-card {
    animation: float-small 6s 0.8s ease-in-out infinite;
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes float-art {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-7px);
    }
  }

  @keyframes float-small {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-5px);
    }
  }

  @keyframes orbit-one {
    from {
      transform: rotate(-17deg);
    }

    to {
      transform: rotate(343deg);
    }
  }

  @keyframes orbit-two {
    from {
      transform: rotate(28deg);
    }

    to {
      transform: rotate(-332deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy,
    .hero-visual,
    .art-frame,
    .diagnostic-card,
    .code-card,
    .orbit-one,
    .orbit-two {
      animation: none;
    }
  }
</style>
