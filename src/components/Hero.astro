---
---

<section id="about" class="py-16 md:py-24 border-b border-[#E2E8F0]">
  <div class="flex flex-col-reverse md:flex-row items-start md:items-center justify-between gap-10">
    <!-- Hero Info -->
    <div class="flex-1 space-y-6">
      <!-- Live Status Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#E2E8F0] bg-white shadow-xs">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="font-mono text-[10px] md:text-xs font-semibold tracking-wider text-[#1E293B]/80 uppercase">
          STATUS: BUILDING & LEARNING
        </span>
      </div>

      <!-- Hero Heading -->
      <div class="space-y-3">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-[#1E293B]">
          Hi, I'm Athrva Pawar.
        </h1>
        <p class="text-lg md:text-xl font-medium text-[#1E293B]/70 font-mono text-blue-600">
          Computer Science Student, Systems Enthusiast &amp; Builder.
        </p>
      </div>

      <!-- Description -->
      <p class="text-sm md:text-base leading-relaxed text-[#1E293B]/80 max-w-xl">
        I'm a Computer Science student who enjoys building things and understanding how they work under the hood. I'm exploring software, computer systems, hardware, and emerging technologies through projects, experiments, and a lot of curiosity.
      </p>

      <!-- CTA and Socials -->
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a 
          href="#projects" 
          class="inline-flex items-center justify-center px-4 py-2 border border-[#E2E8F0] rounded-md bg-[#1E293B] text-xs font-mono font-medium text-white hover:bg-neutral-800 hover:shadow-xs transition-all duration-200"
        >
          View Projects
        </a>
        <a 
          href="https://github.com/athrvapawar14-arch" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center justify-center p-2 border border-[#E2E8F0] rounded-md bg-white text-[#1E293B]/80 hover:text-[#1E293B] hover:bg-neutral-50 hover:border-neutral-300 transition-all duration-200"
          title="GitHub"
        >
          <svg class="h-4.5 w-4.5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482C19.138 20.193 22 16.44 22 12.017 22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
        <a 
          href="https://www.linkedin.com/in/athrva-pawar-2a168519a" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center justify-center p-2 border border-[#E2E8F0] rounded-md bg-white text-[#1E293B]/80 hover:text-[#1E293B] hover:bg-neutral-50 hover:border-neutral-300 transition-all duration-200"
          title="LinkedIn"
        >
          <svg class="h-4.5 w-4.5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Right: Personal Hero Artwork -->
    <div class="relative w-full md:w-1/2 flex justify-center">
      <div class="relative w-full overflow-hidden rounded-xl border border-[#E2E8F0] shadow-sm">
        <img
          src="/images/hero.png"
          alt="Athrva's personal technology and systems artwork"
          class="w-full h-auto object-cover"
        />
      </div>
    </div>
  </div>
</section>
