---
---

<header
  class="sticky top-0 z-50 w-full border-b border-[var(--color-portfolio-border)] bg-[var(--color-portfolio-bg)]/80 backdrop-blur-md transition-all duration-300"
>
  <div class="mx-auto max-w-4xl px-6 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a
      href="/"
      class="group flex items-center gap-2 font-mono text-sm font-semibold tracking-tight text-[var(--color-portfolio-text)]"
    >
      <span class="text-blue-500 font-bold">&lt;</span>
      <span class="relative">
        athrvapawar
        <span
          class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-[var(--color-portfolio-text)] transition-all duration-300 group-hover:w-full"
        ></span>
      </span>
      <span class="text-blue-500 font-bold">/&gt;</span>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-6">
      <div class="relative group">
  <button
    type="button"
    class="flex items-center gap-1 text-sm font-medium text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] transition-colors duration-200"
  >
    About
    <span class="text-xs">▾</span>
  </button>

  <div
    class="absolute left-0 top-full hidden w-48 pt-2 group-hover:block"
  >
    <div
      class="rounded-md border border-[var(--color-portfolio-border)] bg-[var(--color-portfolio-card-bg)] p-2 shadow-sm"
    >
            <a
              href="/about"
              class="block rounded px-3 py-2 text-sm text-[var(--color-portfolio-text)]/70 hover:bg-[var(--color-portfolio-border)] hover:text-[var(--color-portfolio-text)] transition-colors"
            >
              About Me
            </a>

            <a
              href="/about/education"
              class="block rounded px-3 py-2 text-sm text-[var(--color-portfolio-text)]/70 hover:bg-[var(--color-portfolio-border)] hover:text-[var(--color-portfolio-text)] transition-colors"
            >
              Education
            </a>

            <a
              href="/about/experience"
              class="block rounded px-3 py-2 text-sm text-[var(--color-portfolio-text)]/70 hover:bg-[var(--color-portfolio-border)] hover:text-[var(--color-portfolio-text)] transition-colors"
            >
              Experience
            </a>

            <a
              href="/about/achievements"
              class="block rounded px-3 py-2 text-sm text-[var(--color-portfolio-text)]/70 hover:bg-[var(--color-portfolio-border)] hover:text-[var(--color-portfolio-text)] transition-colors"
            >
              Achievements
            </a>

            <a
              href="/about/certifications"
              class="block rounded px-3 py-2 text-sm text-[var(--color-portfolio-text)]/70 hover:bg-[var(--color-portfolio-border)] hover:text-[var(--color-portfolio-text)] transition-colors"
            >
              Certifications
            </a>
          </div>
        </div>
      </div>
      <a
        href="/#projects"
        class="text-sm font-medium text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] transition-colors duration-200"
        >Projects</a
      >
      <a
        href="/notes"
        class="text-sm font-medium text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] transition-colors duration-200"
        >Notes</a
      >
      <a
        href="/#contact"
        class="inline-flex items-center justify-center px-3.5 py-1.5 border border-[var(--color-portfolio-border)] rounded bg-[var(--color-portfolio-card-bg)] text-xs font-mono text-[var(--color-portfolio-text)] hover:bg-[var(--color-portfolio-border)] hover:border-[var(--color-portfolio-muted)] hover:shadow-xs active:bg-[var(--color-portfolio-border)] transition-all duration-200"
      >
        Say Hello
      </a>
    </nav>

    <button
      id="theme-toggle"
      type="button"
      class="rounded-md border border-[var(--color-portfolio-border)] bg-[var(--color-portfolio-button-bg)] px-3 py-1.5 font-mono text-sm text-[var(--color-portfolio-button-text)] transition-colors"
    >
      <span id="theme-icon">☀</span>
    </button>


    <!-- Mobile Nav Toggle -->
    <button
      id="mobile-menu-toggle"
      aria-label="Toggle navigation menu"
      class="md:hidden p-2 text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] focus:outline-hidden"
    >
      <svg
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          id="menu-icon-path"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden border-b border-[var(--color-portfolio-border)] bg-[var(--color-portfolio-bg)] px-6 py-4 flex flex-col gap-4 md:hidden transition-all duration-200"
  >
    <div>
  <button
    id="mobile-about-toggle"
    type="button"
    class="flex w-full items-center justify-between py-1 text-sm font-medium text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] transition-colors"
  >
    <span>About</span>
    <span id="mobile-about-arrow" class="text-xs">▾</span>
  </button>

  <div
    id="mobile-about-menu"
    class="hidden mt-2 ml-3 flex flex-col gap-2 border-l border-[var(--color-portfolio-border)] pl-3"
  >
        <a
          href="/about"
          class="mobile-nav-link text-sm text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] py-1"
        >
          About Me
        </a>

        <a
          href="/about/education"
          class="mobile-nav-link text-sm text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] py-1"
        >
          Education
        </a>

        <a
          href="/about/experience"
          class="mobile-nav-link text-sm text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] py-1"
        >
          Experience
        </a>

        <a
          href="/about/achievements"
          class="mobile-nav-link text-sm text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] py-1"
        >
          Achievements
        </a>

        <a
          href="/about/certifications"
          class="mobile-nav-link text-sm text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] py-1"
        >
          Certifications
        </a>
      </div>
    </div>
    <a
      href="/#projects"
      class="mobile-nav-link text-sm font-medium text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] py-1"
      >Projects</a
    >
    <a
      href="/#blog"
      class="mobile-nav-link text-sm font-medium text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] py-1"
      >Notes</a
    >
    <a
      href="/#contact"
      class="mobile-nav-link inline-flex items-center justify-center w-full py-2 border border-[var(--color-portfolio-border)] rounded bg-[var(--color-portfolio-card-bg)] text-xs font-mono text-[var(--color-portfolio-text)] hover:bg-[var(--color-portfolio-border)] transition-colors"
    >
      Say Hello
    </a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIconPath = document.getElementById("menu-icon-path");
  const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");
  const themeToggle = document.getElementById("theme-toggle");
  const themeIcon = document.getElementById("theme-icon");
  const mobileAboutToggle = document.getElementById("mobile-about-toggle");
  const mobileAboutMenu = document.getElementById("mobile-about-menu");
  const mobileAboutArrow = document.getElementById("mobile-about-arrow");
  console.log(themeToggle);

  let isMenuOpen = false;

  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    if (isMenuOpen) {
      mobileMenu?.classList.remove("hidden");
      menuIconPath?.setAttribute("d", "M6 18L18 6M6 6l12 12");
    } else {
      mobileMenu?.classList.add("hidden");
      menuIconPath?.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
    }
  }

  toggleBtn?.addEventListener("click", toggleMenu);

  function updateThemeIcon() {
    const isDark = document.documentElement.classList.contains("dark");

    if (themeIcon) {
      themeIcon.textContent = isDark ? "☾" : "☀";
    }
  }

  updateThemeIcon();


  mobileAboutToggle?.addEventListener("click", () => {
    mobileAboutMenu?.classList.toggle("hidden");

    const isAboutOpen = !mobileAboutMenu?.classList.contains("hidden");

    if (mobileAboutArrow) {
      mobileAboutArrow.textContent = isAboutOpen ? "▴" : "▾";
    }
  });

  mobileNavLinks.forEach((link) => {
    link.addEventListener("click", () => {
    if (isMenuOpen) toggleMenu();
    });
  });



  themeToggle?.addEventListener("click", () => { 
  document.documentElement.classList.toggle("dark");

  const isDark = document.documentElement.classList.contains("dark");

  localStorage.setItem("theme", isDark ? "dark" : "light");

  updateThemeIcon();
  
  });
</script>