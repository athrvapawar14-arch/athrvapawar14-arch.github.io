---
---

<header class="sticky top-0 z-50 w-full border-b border-[#E2E8F0] bg-[#F8F9FA]/80 backdrop-blur-md transition-all duration-300">
  <div class="mx-auto max-w-4xl px-6 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="#" class="group flex items-center gap-2 font-mono text-sm font-semibold tracking-tight text-[#1E293B]">
      <span class="text-blue-500 font-bold">&lt;</span>
      <span class="relative">
        athrvapawar
        <span class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-[#1E293B] transition-all duration-300 group-hover:w-full"></span>
      </span>
      <span class="text-blue-500 font-bold">/&gt;</span>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-6">
      <a href="#about" class="text-sm font-medium text-[#1E293B]/70 hover:text-[#1E293B] transition-colors duration-200">About</a>
      <a href="#projects" class="text-sm font-medium text-[#1E293B]/70 hover:text-[#1E293B] transition-colors duration-200">Projects</a>
      <a href="#blog" class="text-sm font-medium text-[#1E293B]/70 hover:text-[#1E293B] transition-colors duration-200">Notes</a>
      <a href="#contact" class="inline-flex items-center justify-center px-3.5 py-1.5 border border-[#E2E8F0] rounded bg-white text-xs font-mono text-[#1E293B] hover:bg-neutral-50 hover:border-neutral-300 hover:shadow-xs active:bg-neutral-100 transition-all duration-200">
        Say Hello
      </a>
    </nav>

    <!-- Mobile Nav Toggle -->
    <button 
      id="mobile-menu-toggle" 
      aria-label="Toggle navigation menu"
      class="md:hidden p-2 text-[#1E293B]/70 hover:text-[#1E293B] focus:outline-hidden"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path id="menu-icon-path" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div 
    id="mobile-menu" 
    class="hidden border-b border-[#E2E8F0] bg-[#F8F9FA] px-6 py-4 flex flex-col gap-4 md:hidden transition-all duration-200"
  >
    <a href="#about" class="mobile-nav-link text-sm font-medium text-[#1E293B]/70 hover:text-[#1E293B] py-1">About</a>
    <a href="#projects" class="mobile-nav-link text-sm font-medium text-[#1E293B]/70 hover:text-[#1E293B] py-1">Projects</a>
    <a href="#blog" class="mobile-nav-link text-sm font-medium text-[#1E293B]/70 hover:text-[#1E293B] py-1">Notes</a>
    <a href="#contact" class="mobile-nav-link inline-flex items-center justify-center w-full py-2 border border-[#E2E8F0] rounded bg-white text-xs font-mono text-[#1E293B] hover:bg-neutral-50 transition-colors">
      Say Hello
    </a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconPath = document.getElementById('menu-icon-path');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

  let isMenuOpen = false;

  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    if (isMenuOpen) {
      mobileMenu?.classList.remove('hidden');
      menuIconPath?.setAttribute('d', 'M6 18L18 6M6 6l12 12');
    } else {
      mobileMenu?.classList.add('hidden');
      menuIconPath?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
    }
  }

  toggleBtn?.addEventListener('click', toggleMenu);

  mobileNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (isMenuOpen) toggleMenu();
    });
  });
</script>
