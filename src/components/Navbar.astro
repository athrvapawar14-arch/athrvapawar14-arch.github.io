---
---

<header
  class="sticky top-0 z-50 w-full border-b border-[var(--color-portfolio-border)] bg-[var(--color-portfolio-bg)]/80 backdrop-blur-md transition-all duration-300"
>
  <div class="mx-auto max-w-4xl px-6 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a
      href="/"
      class="group flex items-center gap-2 font-mono text-sm font-semibold tracking-tight text-[var(--color-portfolio-text)]"
    >
      <span class="text-blue-500 font-bold">&lt;</span>
      <span class="relative">
        athrvapawar
        <span
          class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-[var(--color-portfolio-text)] transition-all duration-300 group-hover:w-full"
        ></span>
      </span>
      <span class="text-blue-500 font-bold">/&gt;</span>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-6">
      <a
        href="/about"
        class="text-sm font-medium text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] transition-colors duration-200"
        >About</a
      >
      <a
        href="/#projects"
        class="text-sm font-medium text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] transition-colors duration-200"
        >Projects</a
      >
      <a
        href="/#blog"
        class="text-sm font-medium text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] transition-colors duration-200"
        >Notes</a
      >
      <a
        href="/#contact"
        class="inline-flex items-center justify-center px-3.5 py-1.5 border border-[var(--color-portfolio-border)] rounded bg-[var(--color-portfolio-card-bg)] text-xs font-mono text-[var(--color-portfolio-text)] hover:bg-[var(--color-portfolio-border)] hover:border-[var(--color-portfolio-muted)] hover:shadow-xs active:bg-[var(--color-portfolio-border)] transition-all duration-200"
      >
        Say Hello
      </a>
    </nav>

    <button
      id="theme-toggle"
      type="button"
      class="rounded-md border border-[var(--color-portfolio-border)] bg-[var(--color-portfolio-button-bg)] px-3 py-1.5 font-mono text-sm text-[var(--color-portfolio-button-text)] transition-colors"
    >
      ☀
    </button>


    <!-- Mobile Nav Toggle -->
    <button
      id="mobile-menu-toggle"
      aria-label="Toggle navigation menu"
      class="md:hidden p-2 text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] focus:outline-hidden"
    >
      <svg
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          id="menu-icon-path"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden border-b border-[var(--color-portfolio-border)] bg-[var(--color-portfolio-bg)] px-6 py-4 flex flex-col gap-4 md:hidden transition-all duration-200"
  >
    <a
      href="/about"
      class="mobile-nav-link text-sm font-medium text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] py-1"
      >About</a
    >
    <a
      href="/#projects"
      class="mobile-nav-link text-sm font-medium text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] py-1"
      >Projects</a
    >
    <a
      href="/#blog"
      class="mobile-nav-link text-sm font-medium text-[var(--color-portfolio-text)]/70 hover:text-[var(--color-portfolio-text)] py-1"
      >Notes</a
    >
    <a
      href="/#contact"
      class="mobile-nav-link inline-flex items-center justify-center w-full py-2 border border-[var(--color-portfolio-border)] rounded bg-[var(--color-portfolio-card-bg)] text-xs font-mono text-[var(--color-portfolio-text)] hover:bg-[var(--color-portfolio-border)] transition-colors"
    >
      Say Hello
    </a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIconPath = document.getElementById("menu-icon-path");
  const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");
  const themeToggle = document.getElementById("theme-toggle");
  console.log(themeToggle);

  let isMenuOpen = false;

  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    if (isMenuOpen) {
      mobileMenu?.classList.remove("hidden");
      menuIconPath?.setAttribute("d", "M6 18L18 6M6 6l12 12");
    } else {
      mobileMenu?.classList.add("hidden");
      menuIconPath?.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
    }
  }

  toggleBtn?.addEventListener("click", toggleMenu);

  mobileNavLinks.forEach((link) => {
    link.addEventListener("click", () => {
    if (isMenuOpen) toggleMenu();
    });
  });


  const savedTheme = localStorage.getItem("theme");

  if (savedTheme === "dark") {
      document.documentElement.classList.add("dark");
  }

  themeToggle?.addEventListener("click", () => { 
  document.documentElement.classList.toggle("dark");

  const isDark = document.documentElement.classList.contains("dark");

  localStorage.setItem("theme", isDark ? "dark" : "light");
  
  });
</script>