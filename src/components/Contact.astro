---
const email = "athrvapawar14@gmail.com";

const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(email)}&su=${encodeURIComponent("Hello Athrva")}`;
---

<section id="contact" class="contact-section">
  <div class="contact-card">
    <div class="contact-content">
      <span class="section-label">// GET IN TOUCH</span>

      <h2>Let's Connect.</h2>

      <p>
        I'm a Computer Science student who likes building things and figuring
        out how they work under the hood. If you'd like to talk about a project,
        collaboration, technology, or just say hello, feel free to reach out.
      </p>

      <div class="contact-actions">
        <!-- Gmail -->
        <a
          href={gmailUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="email-button"
        >
          Email Me <span>↗</span>
        </a>

        <!-- Copy email -->
        <button
          id="copy-email"
          class="copy-button"
          type="button"
          data-email={email}
        >
          Copy Email
          <span id="copy-icon">⧉</span>
        </button>
      </div>

      <div class="social-links">
        <a
          href="https://www.linkedin.com/in/athrva-pawar-2a168519a/"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>

        <span>/</span>

        <a
          href="https://github.com/athrvapawar14-arch"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
      </div>
    </div>

    <div class="contact-decoration"></div>
  </div>
</section>

<script>
  const copyButton = document.querySelector("#copy-email");
  const copyIcon = document.querySelector("#copy-icon");

  copyButton?.addEventListener("click", async () => {
    const email = copyButton.getAttribute("data-email");

    if (!email) return;

    try {
      await navigator.clipboard.writeText(email);

      copyButton.childNodes[0].textContent = "Copied! ";
      copyIcon.textContent = "✓";

      setTimeout(() => {
        copyButton.childNodes[0].textContent = "Copy Email ";
        copyIcon.textContent = "⧉";
      }, 2000);
    } catch (error) {
      console.error("Failed to copy email:", error);
    }
  });
</script>

<style>
  .contact-section {
    padding: 5rem 0;
  }

  .contact-card {
    position: relative;
    overflow: hidden;

    max-width: 900px;
    margin: 0 auto;

    padding: 4rem;

    border: 1px solid var(--color-portfolio-border);
    border-radius: 14px;

    background: var(--color-portfolio-card-bg);
  }

  .contact-content {
    position: relative;
    z-index: 1;
    max-width: 750px;
  }

  .section-label {
    color: var(--color-portfolio-accent);
    font-family: monospace;
    font-weight: 600;
  }

  .contact-card h2 {
    margin: 0.75rem 0 1rem;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-portfolio-text);
  }

  .contact-card p {
    max-width: 700px;
    color: var(--color-portfolio-muted);
    line-height: 1.8;
    font-size: 1.05rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .email-button,
  .copy-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    padding: 0.85rem 1.2rem;

    border-radius: 6px;

    font-family: monospace;
    font-size: 0.9rem;

    cursor: pointer;
  }

  .email-button {
    background: var(--color-portfolio-button-bg);
    color: var(--color-portfolio-button-text);
    text-decoration: none;
  }

  .email-button:hover {
    background: var(--color-portfolio-accent);
  }

  .copy-button {
    border: 1px solid var(--color-portfolio-border);
    background: var(--color-portfolio-card-bg);
    color: var(--color-portfolio-text);
  }

  .copy-button:hover {
    border-color: var(--color-portfolio-accent);
    color: var(--color-portfolio-accent);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;

    font-family: monospace;
  }

  .social-links a {
    color: var(--color-portfolio-muted);
    text-decoration: none;
  }

  .social-links a:hover {
    color: var(--color-portfolio-accent);
  }

  .social-links span {
    color: var(--color-portfolio-muted);
  }

  .contact-decoration {
    position: absolute;

    width: 170px;
    height: 170px;

    right: -50px;
    bottom: -70px;

    border-radius: 50%;

    background: var(--color-portfolio-surface);
  }

  @media (max-width: 700px) {
    .contact-card {
      padding: 2rem;
    }

    .contact-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .email-button,
    .copy-button {
      justify-content: center;
    }
  }
</style>
