---

<section id="contact" class="py-16 md:py-24">
  <div class="rounded-xl border border-[#E2E8F0] bg-white p-8 md:p-12 space-y-8 relative overflow-hidden">
    <!-- Background visual mesh -->
    <div class="absolute -right-10 -bottom-10 w-40 h-40 rounded-full border border-blue-50/50 bg-[#F8F9FA] pointer-events-none"></div>

    <div class="max-w-xl space-y-4 relative z-10">
      <span class="font-mono text-xs font-semibold text-blue-500">// GET IN TOUCH</span>
      <h2 class="text-3xl font-bold tracking-tight text-[#1E293B]">
        Let's Connect.
      </h2>
      <p class="text-sm md:text-base leading-relaxed text-[#1E293B]/70">
      I'm a Computer Science student who likes building things and figuring out how they work under the hood. My interests range from software and web development to computer systems, hardware, and emerging technologies. I'm always exploring something new, building small projects, and learning along the way.
      </p>
    </div>

    <!-- Contact CTA and Details -->
    <div class="flex flex-col sm:flex-row sm:items-center gap-4 relative z-10 pt-2">
      <!-- Email Copy Action -->
      <div class="relative flex items-center">
        <button 
          id="copy-email-btn"
          data-email="athrvapawar14@gmail.com"
          class="group inline-flex items-center justify-between gap-4 px-4 py-2.5 border border-[#E2E8F0] rounded-md bg-[#1E293B] text-xs font-mono font-medium text-white hover:bg-neutral-800 hover:shadow-xs transition-all duration-200 cursor-pointer"
        >
          <span id="btn-text">Copy: athrvapawar14@gmail.com</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path id="copy-icon" stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
        </button>
      </div>

      <!-- Socials row -->
      <div class="flex items-center gap-4 font-mono text-xs text-[#1E293B]/60">
        <a href="https://linkedin.com/in/athrva-pawar-2a168519a" target="_blank" rel="noopener noreferrer" class="hover:text-[#1E293B] hover:underline transition-all">LinkedIn</a>
        <span>/</span>
        <a href="https://github.com/athrvapawar14-arch" target="_blank" rel="noopener noreferrer" class="hover:text-[#1E293B] hover:underline transition-all">GitHub</a>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const btnText = document.getElementById('btn-text');
  const copyIcon = document.getElementById('copy-icon');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email') || 'athrvapawar14@gmail.com';
    
    try {
      await navigator.clipboard.writeText(email);
      
      // Visual feedback
      if (btnText) btnText.textContent = "Copied to clipboard!";
      copyBtn.classList.remove('bg-[#1E293B]', 'hover:bg-neutral-800');
      copyBtn.classList.add('bg-emerald-600');
      
      // Reset feedback after 2.5s
      setTimeout(() => {
        if (btnText) btnText.textContent = `Copy: ${email}`;
        copyBtn.classList.remove('bg-emerald-600');
        copyBtn.classList.add('bg-[#1E293B]', 'hover:bg-neutral-800');
      }, 2500);

    } catch (err) {
      console.error('Could not copy text: ', err);
    }
  });
</script>
