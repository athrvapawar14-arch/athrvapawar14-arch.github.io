---
const posts = [
  {
    title: "Orchestrating Autonomous Developer Sandboxes",
    description: "An architectural deep-dive into configuring secure, low-latency execution environments for agentic programming subagents.",
    date: "2026-08-20",
    readTime: "6 min read",
    category: "#architecture"
  },
  {
    title: "Optimizing Rust WebAssembly Payloads in Vite",
    description: "Techniques for shrinking Wasm payloads, managing memory buffers, and achieving near-native rendering speeds inside WebGL canvas contexts.",
    date: "2026-07-15",
    readTime: "4 min read",
    category: "#wasm"
  },
  {
    title: "Migrating to Tailwind CSS v4 & Astro 5",
    description: "A first-look at compiling styles directly using the new `@tailwindcss/vite` plugin, dropping traditional config files, and optimizing assets.",
    date: "2026-06-02",
    readTime: "3 min read",
    category: "#webdev"
  }
];
---

<section id="blog" class="py-16 border-b border-[#E2E8F0]">
  <div class="space-y-8">
    <!-- Section Header -->
    <div class="space-y-2">
      <h2 class="text-2xl font-bold tracking-tight text-[#1E293B] flex items-center gap-2">
        <span class="font-mono text-sm text-blue-500 font-semibold">//</span> Journal &amp; Notes
      </h2>
      <p class="text-sm text-[#1E293B]/60 max-w-lg">
        Thoughts on system architecture, Rust tooling, web optimization, and frontend ergonomics.
      </p>
    </div>

    <!-- Notes List -->
    <div class="divide-y divide-[#E2E8F0] border-t border-[#E2E8F0]">
      {posts.map((post) => (
        <article class="group py-6 md:py-8 flex flex-col md:flex-row md:items-baseline gap-4 md:gap-10 transition-colors duration-200 hover:bg-[#F8F9FA]/50 px-2 rounded-lg -mx-2">
          <!-- Monospace Date & Tag info (Left Col) -->
          <div class="md:w-44 shrink-0 flex flex-row md:flex-col items-center md:items-start justify-between md:justify-start gap-2">
            <time class="font-mono text-xs text-[#1E293B]/50">{post.date}</time>
            <div class="flex items-center gap-2">
              <span class="font-mono text-[10px] text-blue-500 font-medium">{post.category}</span>
              <span class="hidden md:inline font-mono text-[9px] text-[#1E293B]/40">•</span>
              <span class="font-mono text-[10px] text-[#1E293B]/40">{post.readTime}</span>
            </div>
          </div>

          <!-- Post Content (Right Col) -->
          <div class="space-y-2 flex-1">
            <h3 class="font-semibold text-base text-[#1E293B] group-hover:text-blue-600 transition-colors duration-200">
              <a href="#" class="inline-flex items-center gap-1.5 focus:outline-hidden">
                {post.title}
                <svg class="h-3.5 w-3.5 opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </h3>
            <p class="text-xs md:text-sm text-[#1E293B]/70 leading-relaxed max-w-2xl">
              {post.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
