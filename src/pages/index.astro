---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Blog from "../components/Blog.astro";
import Contact from "../components/Contact.astro";
import ComingSoon from "../components/ComingSoon.astro";
---

<Layout title="Athrva Pawar | CS Student & Systems Builder">
  <!-- Sticky Navigation Header -->
  <Navbar />

  <!-- Main Content Wrapper -->
  <main class="flex-1 mx-auto max-w-5xl w-full px-6">
    <!-- Hero Section -->
    <Hero />

    <!-- Currently Exploring -->
    <section class="py-20">
      <div class="flex items-end justify-between gap-6 mb-10">
        <div>
          <span class="font-mono text-xs tracking-widest text-blue-600">
            // CURRENTLY EXPLORING
          </span>

          <h2
            class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight text-[#1E293B]"
          >
            Curiosity has no roadmap.
          </h2>

          <p class="mt-4 max-w-2xl text-[#475569] leading-relaxed">
            Things I'm learning, experimenting with, or slowly falling down the
            rabbit hole of.
          </p>
        </div>

        <span class="hidden md:block font-mono text-xs text-[#64748B]">
          [ 03 active ]
        </span>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        <!-- Quantum Computing -->
        <a
          href="#"
          class="group rounded-2xl border border-[#E2E8F0] bg-white p-6
                 transition-all duration-300
                 hover:-translate-y-1 hover:border-blue-300
                 hover:shadow-lg hover:shadow-blue-500/5"
        >
          <div class="flex items-start justify-between">
            <span class="font-mono text-xs text-blue-600"> 01 </span>

            <span
              class="text-[#94A3B8] transition-transform duration-300 group-hover:translate-x-1"
            >
              →
            </span>
          </div>

          <h3 class="mt-8 text-xl font-semibold text-[#1E293B]">
            Quantum Computing
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-[#64748B]">
            Exploring qubits, quantum circuits, algorithms, and the strange
            world beyond classical computation.
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            <span
              class="rounded-md border border-[#E2E8F0] px-2 py-1 font-mono text-[10px] text-[#64748B]"
            >
              Qubits
            </span>

            <span
              class="rounded-md border border-[#E2E8F0] px-2 py-1 font-mono text-[10px] text-[#64748B]"
            >
              Quantum
            </span>
          </div>
        </a>

        <!-- Photonic Computing -->
        <a
          href="#"
          class="group rounded-2xl border border-[#E2E8F0] bg-white p-6
                 transition-all duration-300
                 hover:-translate-y-1 hover:border-blue-300
                 hover:shadow-lg hover:shadow-blue-500/5"
        >
          <div class="flex items-start justify-between">
            <span class="font-mono text-xs text-blue-600"> 02 </span>

            <span
              class="text-[#94A3B8] transition-transform duration-300 group-hover:translate-x-1"
            >
              →
            </span>
          </div>

          <h3 class="mt-8 text-xl font-semibold text-[#1E293B]">
            Photonic Computing
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-[#64748B]">
            Looking into computing with light, optical hardware, and what
            photonics could mean for future processors.
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            <span
              class="rounded-md border border-[#E2E8F0] px-2 py-1 font-mono text-[10px] text-[#64748B]"
            >
              Photonics
            </span>

            <span
              class="rounded-md border border-[#E2E8F0] px-2 py-1 font-mono text-[10px] text-[#64748B]"
            >
              Hardware
            </span>
          </div>
        </a>

        <!-- Computer Systems -->
        <a
          href="#"
          class="group rounded-2xl border border-[#E2E8F0] bg-white p-6
                 transition-all duration-300
                 hover:-translate-y-1 hover:border-blue-300
                 hover:shadow-lg hover:shadow-blue-500/5"
        >
          <div class="flex items-start justify-between">
            <span class="font-mono text-xs text-blue-600"> 03 </span>

            <span
              class="text-[#94A3B8] transition-transform duration-300 group-hover:translate-x-1"
            >
              →
            </span>
          </div>

          <h3 class="mt-8 text-xl font-semibold text-[#1E293B]">
            Computer Systems
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-[#64748B]">
            Understanding what happens underneath the abstractions — CPUs,
            operating systems, memory, and low-level software.
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            <span
              class="rounded-md border border-[#E2E8F0] px-2 py-1 font-mono text-[10px] text-[#64748B]"
            >
              Systems
            </span>

            <span
              class="rounded-md border border-[#E2E8F0] px-2 py-1 font-mono text-[10px] text-[#64748B]"
            >
              Low-level
            </span>
          </div>
        </a>
      </div>
    </section>

    <!-- Projects Grid Section -->
    <Projects />

    <!-- Coming Soon Section -->
    <ComingSoon />

    <!-- Blog/Notes Section -->
    <Blog />

    <!-- Contact & Copy Email Section -->
    <Contact />
  </main>

  <!-- Clean Footer -->
  <footer class="border-t border-[#E2E8F0] bg-white py-8 mt-auto">
    <div
      class="mx-auto max-w-5xl px-6 flex flex-col md:flex-row
             items-center justify-between gap-4
             font-mono text-[10px] md:text-xs text-[#1E293B]/50"
    >
      <div>© 2026 Athrva. All rights reserved.</div>

      <div class="flex items-center gap-2">
        <span>Built with</span>

        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-blue-500 transition-colors"
        >
          Astro
        </a>

        <span>&amp;</span>

        <a
          href="https://tailwindcss.com"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-blue-500 transition-colors"
        >
          Tailwind CSS
        </a>
      </div>
    </div>
  </footer>
</Layout>
