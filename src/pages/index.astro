---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import KnightCinematic from "../components/KnightCinematic.astro";
---

<Layout
  title="Athrva Pawar | The Bearer"
  description="A cinematic portfolio exploring software, systems, and experiments through an interactive medieval knight."
>
  <Navbar />
  <main class="home-main">
    <KnightCinematic />
  </main>
</Layout>

<style>
  .home-main {
    flex: 1 1 auto;
    width: 100%;
    min-height: 0;
    overflow: hidden;
    background: var(--knight-scene-background);
  }

  /* Keep the landing page a single, intentional viewport. */
  :global(html), :global(body) {
    overflow-x: hidden;
  }
</style>
